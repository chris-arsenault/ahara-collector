# Runs the flake checks inside a nix container so CI needs no nix installer.
# Build context is an explicit allowlist of what the flake reads.
FROM docker.io/nixos/nix:2.31.2 AS source
WORKDIR /src
COPY flake.nix flake.lock ./
COPY hosts ./hosts
COPY lib ./lib
COPY tests ./tests
COPY scripts ./scripts
COPY service ./service

FROM source AS evaluate
RUN nix --extra-experimental-features "nix-command flakes" flake check --no-build --print-build-logs

FROM source AS test
RUN nix --extra-experimental-features "nix-command flakes" build .#checks.x86_64-linux.s13-vm --print-build-logs
